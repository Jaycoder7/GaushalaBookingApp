{
  "name": "gaushala-backend",
  "version": "1.0.0",
  "description": "Gaushala booking backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "ts-node src/database/migrations/run.ts",
    "migration:create": "ts-node src/database/migrations/create.ts",
    "test": "jest",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "pg": "^8.11.1",
    "uuid": "^9.0.0",
    "axios": "^1.5.0",
    "resend": "^1.0.0",
    "jsonwebtoken": "^9.1.0",
    "express-rate-limit": "^7.0.0",
    "google-auth-library": "^8.9.0",
    "googleapis": "^118.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.20",
    "@types/node": "^20.5.0",
    "@types/pg": "^8.10.7",
    "@types/uuid": "^9.0.2",
    "@types/jest": "^29.5.3",
    "typescript": "^5.1.6",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "jest": "^29.6.4",
    "ts-jest": "^29.1.1",
    "@typescript-eslint/eslint-plugin": "^6.4.0",
    "@typescript-eslint/parser": "^6.4.0",
    "eslint": "^8.47.0"
  }
}
